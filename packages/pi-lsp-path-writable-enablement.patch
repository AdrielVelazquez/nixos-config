+/**
+ * Resolve LSP settings with the global enablement overlay above settings.json's own global
+ * enablement and below a trusted project's. A damaged overlay is reported and ignored.
+ */
+export function resolveLspSettingsWithOverlay(
+  reader: LspSettingsReader,
+  agentDirectory: string,
+): ResolvedLspSettings {
+  const resolved = resolveLspSettings(reader);
+  const damaged = (reason: string): ResolvedLspSettings => ({
+    ...resolved,
+    warnings: [...resolved.warnings, `global ${GLOBAL_OVERLAY_FILE}: ${reason}`],
+  });
+  let text: string;
+  try {
+    text = readFileSync(resolve(agentDirectory, GLOBAL_OVERLAY_FILE), "utf8");
+  } catch (error) {
+    const missing = error instanceof Error && "code" in error && error.code === "ENOENT";
+    return missing ? resolved : damaged(error instanceof Error ? error.message : String(error));
+  }
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text.startsWith("\uFEFF") ? text.slice(1) : text);
+  } catch (error) {
+    return damaged(error instanceof Error ? error.message : String(error));
+  }
+  if (!Value.Check(SettingsDocumentSchema, parsed)) {
+    return damaged('expected {"lsp":{"enablement":{"<server-id>": true | false}}}');
+  }
+  const enablement = new Map(resolved.enablement);
+  for (const [serverId, enabled] of Object.entries(parsed.lsp?.enablement ?? {})) {
+    if (enablement.get(serverId)?.scope !== "project") {
+      enablement.set(serverId, { enabled, scope: "global" });
+    }
+  }
+  return { ...resolved, enablement };
+}
