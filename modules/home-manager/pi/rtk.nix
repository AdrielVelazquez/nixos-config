{
  config,
  lib,
  pkgs,
  piLib,
  ...
}:
let
  cfg = config.local.pi.rtk;
  # rtk's own Pi integration, generated by its installer in a throwaway home: run for real it writes into
  # ~/.pi/agent/extensions, which Nix owns. The extension is rtk's file, unmodified; it delegates every decision to
  # `rtk rewrite`, so its rules always match the binary it is built with. The environment is scrubbed because rtk
  # resolves Pi's agent directory from PI_CODING_AGENT_DIR before it looks at HOME.
  extension =
    pkgs.runCommand "pi-rtk-extension-${cfg.package.version}" { nativeBuildInputs = [ cfg.package ]; }
      ''
        export HOME="$TMPDIR/home" XDG_CONFIG_HOME="$TMPDIR/config" XDG_DATA_HOME="$TMPDIR/data" XDG_STATE_HOME="$TMPDIR/state"
        export PI_CODING_AGENT_DIR="$TMPDIR/agent"
        unset PI_CONFIG_DIR OMP_CODING_AGENT_DIR RTK_DISABLED
        mkdir -p "$HOME" "$PI_CODING_AGENT_DIR"
        rtk init --global --agent pi
        install -D "$PI_CODING_AGENT_DIR/extensions/rtk.ts" "$out/rtk.ts"
      '';
in
{
  options.local.pi.rtk = {
    enable = piLib.mkFeatureEnable "rewriting the bash commands the model runs through rtk, which prints them compactly";
    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.rtk;
      defaultText = lib.literalExpression "pkgs.rtk";
      description = "The rtk build whose installer generates the extension and whose `rtk rewrite` the extension calls at run time.";
    };
    entry = lib.mkOption {
      type = lib.types.str;
      readOnly = true;
      internal = true;
      default = "${extension}/rtk.ts";
    };
  };

  config = lib.mkIf (config.local.pi.enable && cfg.enable) {
    # `rtk rewrite` runs from PATH, where Home Manager already puts rtk. The extension reports "RTK disabled" in the
    # footer and passes commands through unchanged when it is missing.
    local.pi.extraSettings.extensions = [ cfg.entry ];
    # The build and plan children run bash too; scout, explore and title have no shell.
    local.pi.routing.writerExtensions = [ cfg.entry ];
  };
}
