{
  lib,
  config,
  inputs,
  pkgs,
  ...
}:

let
  cfg = config.local.tuios;
  tomlFormat = pkgs.formats.toml { };
  # Kitty only sees tuios's own screen, so open the focused pane's scrollback
  # from tuios in a read-only Neovim buffer instead.
  paneScrollback = pkgs.writeShellScript "tuios-pane-scrollback" ''
    ${lib.getExe' cfg.package "tuios"} capture-pane -w "$TUIOS_ACTIVE_PANE_ID" --scrollback \
      | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' \
      | nvim -R -c 'normal! G' -c 'nnoremap <silent> q :qa!<CR>' -
  '';
  # Ctrl+Alt+N jumps to session N, like Alt+N does for workspaces.
  sessionJumpKeys = lib.listToAttrs (
    map (n: lib.nameValuePair "switch_session_${toString n}" [ "ctrl+alt+${toString n}" ]) (
      lib.range 1 9
    )
  );
  # One line for the dock: how many agents, across every session, are in each
  # state, most urgent first and skipping empty states. It exits non-zero with
  # no agents or no daemon, which hides the cell.
  agentSummary = pkgs.writeShellApplication {
    name = "tuios-agent-summary";
    runtimeInputs = [
      cfg.package
      pkgs.jq
    ];
    text = ''
      summary=$(tuios list-agents --all-sessions --json | jq -r '
        (.agents // []) as $agents
        | def n(state): $agents | map(select(.state == state)) | length;
        [
          [n("needs_input"), "needs you"],
          [n("errored"), "errored"],
          [n("working"), "working"],
          [n("idle"), "idle"],
          [n("done"), "done"],
          [n("unknown"), "unknown"]
        ]
        | map(select(.[0] > 0) | "\(.[0]) \(.[1])")
        | join(" · ")
      ')
      [ -n "$summary" ] || exit 1
      printf '%s\n' "$summary"
    '';
  };
  # The upstream package installs no completions, so generate the zsh one.
  zshCompletion = pkgs.runCommand "tuios-zsh-completion" { } ''
    mkdir -p "$out/share/zsh/site-functions"
    ${lib.getExe' cfg.package "tuios"} completion zsh > "$out/share/zsh/site-functions/_tuios"
  '';
  opencodeIntegration = pkgs.runCommand "tuios-opencode-integration-${cfg.package.version}" { } ''
    export HOME="$TMPDIR/home"
    mkdir -p "$HOME" "$out/opencode"

    XDG_CONFIG_HOME="$out" ${lib.getExe' cfg.package "tuios"} integration install opencode \
      --command ${lib.getExe' cfg.package "tuios"}
  '';
  antigravityIntegration = pkgs.runCommand "tuios-antigravity-integration-${cfg.package.version}" { } ''
    export HOME="$TMPDIR/home"
    mkdir -p "$HOME/.gemini/config" "$out"

    ${lib.getExe' cfg.package "tuios"} integration install antigravity \
      --command ${lib.getExe' cfg.package "tuios"}
    cp "$HOME/.gemini/config/hooks.json" "$out/hooks.json"
  '';
in
{
  options.local.tuios = {
    enable = lib.mkEnableOption "TUIOS terminal window manager";
    package = lib.mkOption {
      type = lib.types.package;
      default = inputs.tuios.packages.${pkgs.stdenv.hostPlatform.system}.tuios;
      defaultText = lib.literalExpression "inputs.tuios.packages.\${system}.tuios";
      description = "TUIOS package from the upstream flake input.";
    };
    settings = lib.mkOption {
      type = tomlFormat.type;
      default = { };
      description = ''
        Contents of TUIOS's `config.toml`. Home Manager owns the file as a
        read-only store symlink, so the settings page and `tuios set-config`
        cannot change it; edit these options instead. Keys left out keep
        TUIOS's defaults.
      '';
    };
    integrations.opencode.enable = lib.mkOption {
      type = lib.types.bool;
      default = config.programs.opencode.enable;
      defaultText = lib.literalExpression "config.programs.opencode.enable";
      description = ''
        Install TUIOS's OpenCode agent-state plugin declaratively. The files are
        generated by the packaged `tuios integration install opencode` during a
        build, so the Agents settings tab reports them as installed and they
        follow package updates.
      '';
    };
    integrations.antigravity.enable = lib.mkEnableOption ''
      TUIOS's Antigravity CLI hook declaratively. The `hooks.json` is generated by
      the packaged `tuios integration install antigravity` during a build and
      linked read-only, so Home Manager owns the whole file and other
      Antigravity hooks must be declared here. The hook reports only the
      conversation id, so pane state still comes from screen rules'';
  };

  config = lib.mkIf cfg.enable {
    home.packages = [
      cfg.package
      zshCompletion
    ];

    local.tuios.settings = {
      startup = {
        tiled = true;
        daemon = true;
      };
      spotlight.enabled = false;
      # No mode pill; the armed leader key still shows as a PREFIX badge. Also
      # drop the pane-count readout, tape and copy indicators and the session
      # buttons, keeping the session name, workspaces, minimized panes and
      # notifications. The session name stays visible when the rail is hidden.
      dock = {
        left = [
          "session"
          "workspaces"
        ];
        session = {
          format = "{session}";
          bold = true;
        };
        center = [
          "custom/agents"
          "windows"
        ];
        right = [
          "notifications"
          "copy-help"
        ];
        custom.agents = {
          command = lib.getExe agentSummary;
          refresh = "event:agent-state,window-created,window-closed";
          # A cap only: the cell is as wide as its text. Room for all six states
          # at once, which is 65 characters with single-digit counts.
          max-width = 72;
        };
      };
      # Reopen each restored OpenCode pane's conversation; `opencode` on PATH is
      # already the Headroom-wrapping launcher.
      daemon.resume_agents = "auto";
      # Let the Neovim navigator plugin move through Neovim splits before tuios
      # panes. Its keymaps in dotfiles/nvim/plugin must match terminal_focus_*.
      appearance.nvim_navigation = true;
      keybindings = {
        # Super+B leads chords; Ctrl+B collides with Neovim's page-back mapping.
        leader_key = "super+b";
        # Both modes, replacing Kitty's tab shortcuts.
        global = {
          new_window = [ "ctrl+shift+t" ];
          close_window = [ "ctrl+shift+q" ];
          next_session = [ "ctrl+tab" ];
          prev_session = [ "ctrl+shift+tab" ];
          last_session = [ "ctrl+alt+0" ];
          toggle_zoom = [ "alt+z" ];
          prefix_inbox = [ "ctrl+shift+a" ];
          prefix_toggle_sidebar = [ "ctrl+s" ];
        }
        // sessionJumpKeys;
        command = [
          {
            key = "ctrl+shift+s";
            type = "popup";
            command = "${paneScrollback}";
            description = "Pane scrollback in Neovim";
            width = "95%";
            height = "95%";
          }
        ];
        # Super+Alt+arrows move between panes, leaving Alt+arrows to the
        # shell's word-wise cursor movement.
        terminal_mode = {
          terminal_focus_left = [ "alt+super+left" ];
          terminal_focus_right = [ "alt+super+right" ];
          terminal_focus_up = [ "alt+super+up" ];
          terminal_focus_down = [ "alt+super+down" ];
        };
        # Panes always tile: unbind every key that toggles floating mode. The
        # command palette and CLI can still toggle it.
        layout.toggle_tiling = [ ];
        prefix_mode.prefix_toggle_tiling = [ ];
        window_prefix.window_prefix_tiling = [ ];
      };
      # Terminal rail without the folder browser, plus the focused pane's git
      # state and a taller agents list.
      appearance.sidebar.sections = "sessions:25,terminals,git:8,agents:50";
      # Show each session's switch number, matching Ctrl+Alt+1..9.
      appearance.sidebar.show_numbers = true;
      # A blank row before each rail section after the first, so sessions,
      # terminals, git and agents read as separate blocks.
      appearance.sidebar.density = "roomy";
      # Fill the current session's name, not just a gutter bar, so Ctrl+Tab
      # cycling is easy to follow.
      appearance.sidebar.row_style = "pill";
      # Zoom fills the whole pane region instead of a 95% bordered box.
      appearance.zoom_borderless = true;
      # One-row dock without the rule line, giving panes an extra row.
      appearance.dock_compact = true;
      appearance.dock_pill_caps = false;
      # Unfocused panes default to a red border; use a quiet grey instead.
      appearance.border_unfocused_color = "#45475a";
    };

    xdg.configFile = lib.mkMerge [
      {
        "tuios/config.toml" = {
          source = tomlFormat.generate "tuios-config.toml" cfg.settings;
          # Replace the file TUIOS generated on first start.
          force = true;
        };
      }
      (lib.mkIf cfg.integrations.opencode.enable {
        "opencode/plugins/tuios-agent-state.js".source =
          "${opencodeIntegration}/opencode/plugins/tuios-agent-state.js";
        "opencode/plugins/tuios-agent-state".source =
          "${opencodeIntegration}/opencode/plugins/tuios-agent-state";
      })
    ];

    home.file = lib.mkIf cfg.integrations.antigravity.enable {
      ".gemini/config/hooks.json".source = "${antigravityIntegration}/hooks.json";
    };
  };
}
