{
  lib,
  pkgs,
  homeConfigurations,
  ...
}:
let
  fixture =
    (homeConfigurations.cachyos-framework13.extendModules {
      modules = [ { local.pi.enable = lib.mkForce true; } ];
    }).config;
  entry = fixture.local.pi.rtk.entry;
  # Compared as text, not as a dependency.
  entryPath = builtins.unsafeDiscardStringContext entry;
  agentFile =
    name: lib.attrByPath [ "${fixture.local.pi.agentDir}/agents/${name}.md" "text" ] "" fixture.home.file;
in
{
  # rtk's own extension, generated by its installer in the build, rewrites the bash commands of the interactive
  # session and of the children that have a shell; the read-only roles never get it.
  pi-rtk =
    assert lib.elem entry fixture.programs.pi-coding-agent.settings.extensions;
    assert lib.elem entry fixture.local.pi.routing.writerExtensions;
    assert lib.hasInfix "subagentOnlyExtensions: ${entryPath}" (agentFile "build");
    assert lib.all (name: !lib.hasInfix entryPath (agentFile name)) [
      "scout"
      "explore"
      "title"
    ];
    pkgs.runCommand "pi-rtk-check"
      {
        nativeBuildInputs = [
          pkgs.python3
          pkgs.coreutils
        ];
      }
      ''
        grep -q 'rtk rewrite' ${entry}
        timeout 300s python3 -E ${../tests/pi}/rtk-session.py ${lib.getExe pkgs.pi-coding-agent} ${entry} ${lib.getExe fixture.local.pi.rtk.package} "$out"
      '';
}
