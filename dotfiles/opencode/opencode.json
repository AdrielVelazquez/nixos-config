{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "snapshots": true,
  "experimental": {
    "todo": true,
    "codemode_vm": true
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.gnupg/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.gnupg/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.gnupg/*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:CODEX_GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  },
  "providers": {
    "llama-cpp": {
      "name": "llama.cpp (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "no-key"
      },
      "models": {
        "HauhauCS/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive:Q4_K_M": {
          "name": "Qwen3.6 35B A3B Uncensored HauhauCS (Q4_K_M)"
        }
      }
    }
  }
}
